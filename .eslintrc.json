{
  "root": true,
  "env": { "browser": true, "es2022": true },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "settings": {},
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off"
  }
}
